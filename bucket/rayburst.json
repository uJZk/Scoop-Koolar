{
    "version": "4.1.1",
    "description": "A full-featured download manager powered by aria2-next.",
    "homepage": "https://github.com/AnInsomniacy/rayburst",
    "license": "MIT",
    "notes": "Choose Rayburst in Windows Settings > Apps > Default apps to associate torrent files and supported link protocols.",
    "architecture": {
        "64bit": {
            "url": "https://github.com/AnInsomniacy/rayburst/releases/download/v4.1.1/Rayburst_4.1.1_x64-setup.exe#/dl.7z",
            "hash": "1c82b728f95e310699d0a44f822b089d3f50b1593fe4417742efbe56914a8c45"
        },
        "arm64": {
            "url": "https://github.com/AnInsomniacy/rayburst/releases/download/v4.1.1/Rayburst_4.1.1_arm64-setup.exe#/dl.7z",
            "hash": "190be7269341f87256e6ea3d7c82a9001024e7e5d16afb1a3f2e486c694bff52"
        }
    },
    "pre_install": [
        "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name Koolar) scripts/utils.psm1)",
        "Initialize-ExternalRuntimeData -Source \"$persist_dir\\APPDATA\" -Target \"$env:APPDATA\\dev.aninsomniacy.rayburst\"",
        "Initialize-ExternalRuntimeData -Source \"$persist_dir\\LOCALAPPDATA\" -Target \"$env:LOCALAPPDATA\\dev.aninsomniacy.rayburst\"",
        "Remove-Module -Name utils"
    ],
    "post_install": [
        "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name Koolar) scripts/utils.psm1)",
        "Mount-ExternalRuntimeData -Source \"$persist_dir\\APPDATA\" -Target \"$env:APPDATA\\dev.aninsomniacy.rayburst\"",
        "Mount-ExternalRuntimeData -Source \"$persist_dir\\LOCALAPPDATA\" -Target \"$env:LOCALAPPDATA\\dev.aninsomniacy.rayburst\"",
        "",
        "'install-associations', 'uninstall-associations' | ForEach-Object {",
        "    $content = Get-Content \"$bucketsdir\\$bucket\\scripts\\$app\\$_.ps1\" -Raw",
        "    $content = $content.Replace('{{scoop_dir}}', $dir)",
        "    $content = $content.Replace('{{registry_scope}}', $(if ($global) { 'HKLM' } else { 'HKCU' }))",
        "    Set-Content -Path \"$dir\\$_.ps1\" -Value $content -Encoding UTF8",
        "}",
        "& \"$dir\\install-associations.ps1\"",
        "",
        "Start-RunningApplication -StatePath \"$persist_dir\\.pre-uninstall-state.json\" -ExecutablePath \"$dir\\rayburst.exe\"",
        "Remove-Module -Name utils"
    ],
    "pre_uninstall": [
        "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name Koolar) scripts/utils.psm1)",
        "Stop-RunningApplication -ProcessName @('rayburst', 'aria2-next', 'rayburst-browser-launcher') -StatePath \"$persist_dir\\.pre-uninstall-state.json\"",
        "Dismount-ExternalRuntimeData -Target \"$env:APPDATA\\dev.aninsomniacy.rayburst\"",
        "Dismount-ExternalRuntimeData -Target \"$env:LOCALAPPDATA\\dev.aninsomniacy.rayburst\"",
        "Remove-Module -Name utils"
    ],
    "uninstaller": {
        "script": "& \"$dir\\uninstall-associations.ps1\""
    },
    "shortcuts": [
        [
            "rayburst.exe",
            "Rayburst"
        ]
    ],
    "checkver": {
        "github": "https://github.com/AnInsomniacy/rayburst"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/AnInsomniacy/rayburst/releases/download/v$version/Rayburst_$version_x64-setup.exe#/dl.7z"
            },
            "arm64": {
                "url": "https://github.com/AnInsomniacy/rayburst/releases/download/v$version/Rayburst_$version_arm64-setup.exe#/dl.7z"
            }
        }
    }
}
