    "shortcuts": [
        [
            "Wabbajack.exe",
            "Wabbajack"
        ]
    ],
    "bin": "cli/wabbajack-cli.exe",
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
