{
    "version": "1.18.250",
    "description": "FluentCleaner Classic - Lightweight Windows system cleaning tool built with .NET Framework 4.8 and WinForms.",
    "homepage": "https://github.com/builtbybel/FluentCleaner",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/builtbybel/FluentCleaner/releases/download/26.09.01/FluentCleaner-Classic-net48.zip",
            "hash": "42703e673cff81eb9d2ec7f8eacaaf93fa009915ffca40e54b63ba789d80fe85",
            "extract_dir": "FluentCleaner-Classic-net48"
        }
    },
    "pre_uninstall": [
        "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name Koolar) scripts/utils.psm1)",
        "Stop-RunningApplication -ProcessName @('FluentCleaner.Classic') -StatePath \"$persist_dir\\.pre-uninstall-state.json\"",
        "Remove-Module -Name utils"
    ],
    "shortcuts": [
        [
            "FluentCleaner.Classic.exe",
            "FluentCleaner Classic"
        ]
    ],
    "persist": "settings.json",
    "pre_install": [
        "if (!(Test-Path \"$dir\\settings.json\") -or !(Get-Item \"$dir\\settings.json\").Length) {",
        "    New-Item \"$dir\\settings.json\" -ItemType File -Force | Out-Null",
        "    Set-Content -Path \"$dir\\settings.json\" -Value '{}'",
        "}"
    ],
    "checkver": {
        "url": "https://api.github.com/repos/builtbybel/FluentCleaner/releases?per_page=1",
        "jsonpath": "$..body",
        "regex": "\\|[ \\t]*\\*{0,2}Classic\\*{0,2}[^|]*\\|[ \\t]*`?v?(?<version>\\d+(?:\\.\\d+)+)`?[^|]*\\|[^)]*\\((?<url>https://github\\.com/builtbybel/FluentCleaner/releases/download/[^)]+/FluentCleaner-Classic-net48\\.zip)\\)"
    },
    "autoupdate": {
        "url": "$matchUrl",
        "extract_dir": "FluentCleaner-Classic-net48"
    }
}
