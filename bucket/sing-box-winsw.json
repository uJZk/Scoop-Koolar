{
    "version": "1.15.0-alpha.13",
    "description": "The universal proxy platform.",
    "homepage": "https://sing-box.sagernet.org/",
    "license": "GPL-3.0-or-later",
    "depends": "Koolar/winsw",
    "suggest": {
        "Koolar/proxifyre-winsw": "A Windows SOCKS5 proxifier that leverages NDISAPI to transparently route TCP and UDP traffic on a per-application basis. It can be used together with sing-box to proxy applications that do not support SOCKS5 proxy natively."
    },
    "notes": [
        "sing-box is installed as a Windows service through WinSW.",
        "If you want to use TUN mode, please run the sing-box service with administrator privileges.",
        "Please set system proxy manually if you want to use."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/SagerNet/sing-box/releases/download/v1.15.0-alpha.13/sing-box-1.15.0-alpha.13-windows-amd64.zip",
            "hash": "7cff6a39687a12d51b289bd57a203723629eb8fd42f6668601b4484456436bc9",
            "extract_dir": "sing-box-1.15.0-alpha.13-windows-amd64"
        },
        "32bit": {
            "url": "https://github.com/SagerNet/sing-box/releases/download/v1.15.0-alpha.13/sing-box-1.15.0-alpha.13-windows-386.zip",
            "hash": "fd2a1867c3284ba77501f5b29ce0c07dfc5a74b2ab5e77ee29b6643952ced5f7",
            "extract_dir": "sing-box-1.15.0-alpha.13-windows-386"
        },
        "arm64": {
            "url": "https://github.com/SagerNet/sing-box/releases/download/v1.15.0-alpha.13/sing-box-1.15.0-alpha.13-windows-arm64.zip",
            "hash": "38aa9f309f1be70619e5160aa74d38a0803a5c7340be143381db8143c964f657",
            "extract_dir": "sing-box-1.15.0-alpha.13-windows-arm64"
        }
    },
    "pre_install": [
        "if (!(Test-Path \"$persist_dir\")) { New-Item -Path \"$persist_dir\" -ItemType Directory | Out-Null }",
        "if (!(Test-Path \"$persist_dir\\config.json\")) {",
        "   $utf8NoBom = New-Object System.Text.UTF8Encoding($false)",
        "   [System.IO.File]::WriteAllText(\"$persist_dir\\config.json\", \"{}`n\", $utf8NoBom)",
        "} elseif ([string]::IsNullOrWhiteSpace((Get-Content -Path \"$persist_dir\\config.json\" -Raw))) {",
        "   Write-Host",
        "   Write-Host \"Please add a config URL to config-url.txt or manually place your config.json in the persist directory before starting.\" -ForegroundColor Red",
        "}",
        "if (!(Test-Path \"$persist_dir\\cache.db\")) { New-Item -Path \"$persist_dir\\cache.db\" -ItemType File | Out-Null }",
        "$persistXml = Join-Path $persist_dir 'sing-box.xml'",
        "$installXml = Join-Path $dir 'sing-box.xml'",
        "$urlFile = Join-Path $persist_dir 'config-url.txt'",
        "if (Test-Path -LiteralPath $persistXml) {",
        "    $xmlPath = $persistXml",
        "    [xml]$xml = Get-Content -LiteralPath $xmlPath -Raw",
        "} else {",
        "    $xmlPath = $installXml",
        "    [xml]$xml = '<service><id>sing-box</id><name>sing-box</name><description>The universal proxy platform.</description><executable>%BASE%\\sing-box.exe</executable><arguments>run -c \"%BASE%\\config.json\"</arguments><log mode=\"reset\"></log><onfailure action=\"restart\" delay=\"5 sec\" /></service>'",
        "}",
        "$existingPrestart = $xml.DocumentElement.SelectSingleNode('prestart')",
        "if ($existingPrestart -and $existingPrestart.arguments -notmatch 'update-config\\.ps1') {",
        "    throw 'An existing custom WinSW prestart command must be migrated manually.'",
        "}",
        "$downloads = @($xml.DocumentElement.SelectNodes('download') | Where-Object { $_.GetAttribute('to') -match '(?i)(^|[\\\\/])config\\.json$' })",
        "if ($downloads.Count -gt 1) { throw 'Multiple config.json downloads require manual migration.' }",
        "$url = if (Test-Path -LiteralPath $urlFile) { [IO.File]::ReadAllText($urlFile) } else { '' }",
        "if ([string]::IsNullOrWhiteSpace($url) -and $downloads.Count -eq 1) { $url = $downloads[0].GetAttribute('from') }",
        "[IO.File]::WriteAllText($urlFile, $url, (New-Object Text.UTF8Encoding($false)))",
        "foreach ($download in $downloads) { [void]$xml.DocumentElement.RemoveChild($download) }",
        "if (-not $existingPrestart) {",
        "    $existingPrestart = $xml.CreateElement('prestart')",
        "    [void]$xml.DocumentElement.AppendChild($existingPrestart)",
        "}",
        "$existingPrestart.RemoveAll()",
        "$exe = $xml.CreateElement('executable')",
        "$exe.InnerText = 'powershell.exe'",
        "[void]$existingPrestart.AppendChild($exe)",
        "$argsNode = $xml.CreateElement('arguments')",
        "$argsNode.InnerText = '-NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"%BASE%\\update-config.ps1\"'",
        "[void]$existingPrestart.AppendChild($argsNode)",
        "$xml.Save($xmlPath)",
        "$updateScript = Join-Path (Find-BucketDirectory -Root -Name Koolar) 'scripts/sing-box-winsw/update-config.ps1'",
        "Copy-Item -LiteralPath $updateScript -Destination (Join-Path $dir 'update-config.ps1') -Force"
    ],
    "post_install": [
        "$winswConfig = \"$dir\\sing-box.xml\"",
        "$postInstallScript = \"$dir\\_post_install.ps1\"",
        "Set-Content -Path $postInstallScript -Value @\"",
        "`$service = Get-Service -Name sing-box -ErrorAction SilentlyContinue",
        "if (`$null -eq `$service) {",
        "    Write-Host 'Service not found, installing sing-box as a service...' -ForegroundColor Yellow",
        "    winsw install '$winswConfig'",
        "} else {",
        "    Write-Host 'Service already exists, refreshing...' -ForegroundColor Yellow",
        "    winsw refresh '$winswConfig'",
        "}",
        "\"@",
        "Write-Host",
        "sudo powershell -NoProfile -ExecutionPolicy Bypass -File \"$postInstallScript\"",
        "Remove-Item \"$postInstallScript\" -ErrorAction SilentlyContinue",
        "Write-Host \"List of useful commands:\" -ForegroundColor Blue",
        "Write-Host \"winsw status '$winswConfig'\" -ForegroundColor Blue",
        "Write-Host \"winsw refresh '$winswConfig'\" -ForegroundColor Blue",
        "Write-Host \"winsw start '$winswConfig'\" -ForegroundColor Blue",
        "Write-Host \"winsw stop '$winswConfig'\" -ForegroundColor Blue",
        "Write-Host \"winsw restart '$winswConfig'\" -ForegroundColor Blue"
    ],
    "pre_uninstall": [
        "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name Koolar) scripts/utils.psm1)",
        "Stop-RunningApplication -ProcessName @('sing-box') -ServiceName @('sing-box') -StatePath \"$persist_dir\\.pre-uninstall-state.json\"",
        "$preUninstallScript = \"$dir\\_pre_uninstall.ps1\"",
        "Set-Content -Path $preUninstallScript -Value @\"",
        "`$service = Get-Service -Name sing-box -ErrorAction SilentlyContinue",
        "if (`$null -ne `$service) {",
        "    Write-Host 'Stopping and uninstalling sing-box service...' -ForegroundColor Yellow",
        "    winsw stop '$dir\\sing-box.xml'",
        "    winsw uninstall '$dir\\sing-box.xml'",
        "}",
        "if (Test-Path '$dir\\tailscale') {",
        "    takeown /f '$dir\\tailscale' /r /d y | Out-Null",
        "    icacls '$dir\\tailscale' /reset /t /q",
        "    icacls '$dir\\tailscale' /grant '*S-1-5-32-545:(OI)(CI)F' /t /q",
        "}",
        "\"@",
        "Write-Host",
        "sudo powershell -NoProfile -ExecutionPolicy Bypass -File \"$preUninstallScript\"",
        "Remove-Item \"$preUninstallScript\" -ErrorAction SilentlyContinue"
    ],
    "bin": "sing-box.exe",
    "persist": [
        "config",
        "config.d",
        "config.json",
        "cache.db",
        "tailscale",
        "sing-box.xml",
        "config-url.txt"
    ],
    "checkver": {
        "url": "https://api.github.com/repos/SagerNet/sing-box/releases",
        "jsonpath": "$.[?(@.prerelease==true)].tag_name",
        "regex": "v([-\\d.\\w]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/SagerNet/sing-box/releases/download/v$version/sing-box-$version-windows-amd64.zip",
                "extract_dir": "sing-box-$version-windows-amd64"
            },
            "32bit": {
                "url": "https://github.com/SagerNet/sing-box/releases/download/v$version/sing-box-$version-windows-386.zip",
                "extract_dir": "sing-box-$version-windows-386"
            },
            "arm64": {
                "url": "https://github.com/SagerNet/sing-box/releases/download/v$version/sing-box-$version-windows-arm64.zip",
                "extract_dir": "sing-box-$version-windows-arm64"
            }
        }
    }
}
