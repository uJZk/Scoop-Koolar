    "notes": "MPC Video Renderer has been registered to the system.",
    "post_install": "sudo -E --inline cmd /c \"$dir\\Install_MPCVR_32.cmd && $dir\\Install_MPCVR_64.cmd\"",
    "pre_uninstall": [
        "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name Koolar) scripts/utils.psm1)",
        "Stop-RunningApplication -ProcessName @('mpc-hc64', 'mpc-be64', 'PotPlayerMini64', 'PotPlayerMini') -StatePath \"$persist_dir\\.pre-uninstall-state.json\"",
        "Remove-Module -Name utils",
        "",
        "sudo -E --inline cmd /c \"$dir\\Uninstall_MPCVR_32.cmd && $dir\\Uninstall_MPCVR_64.cmd\""
    ],
    "checkver": {
        "url": "https://api.github.com/repos/Aleksoid1978/VideoRenderer/releases?per_page=1",
        "jsonpath": "$[0].name",
        "regex": "[\\w ]*?([\\d.]+)"
    },
    "autoupdate": {
        "url": "https://github.com/Aleksoid1978/VideoRenderer/releases/download/$matchHead/MpcVideoRenderer-$version.zip"
    }
}
