    "license": "Freeware",
    "url": "https://filecdn.minimax.chat/public/minimax-agent-prod/release/MiniMax%20Code%20Setup%203.0.74.exe#/dl.7z",
    "hash": "6dfee11508a5cda66312472bb69c5f5215a0ce0713966114d015ea59b17d4d94",
    "installer": {
        "script": [
            "Expand-7ZipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\" -Removal",
            "Remove-Item \"$dir\\`$PLUGINSDIR\", \"$dir\\`$R0\" -Recurse -Force -ErrorAction SilentlyContinue"
        ]
    },
    "pre_install": [
        "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name Koolar) scripts/utils.psm1)",
        "Initialize-ExternalRuntimeData -Source \"$persist_dir\\APPDATA\" -Target \"$env:APPDATA\\MiniMax\"",
        "Remove-Module -Name utils"
    ],
    "post_install": [
        "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name Koolar) scripts/utils.psm1)",
        "Mount-ExternalRuntimeData -Source \"$persist_dir\\APPDATA\" -Target \"$env:APPDATA\\MiniMax\"",
        "Remove-Module -Name utils"
    ],
    "pre_uninstall": [
        "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name Koolar) scripts/utils.psm1)",
        "Stop-RunningApplication -ProcessName @('MiniMax Code') -StatePath \"$persist_dir\\.pre-uninstall-state.json\"",
        "Dismount-ExternalRuntimeData -Target \"$env:APPDATA\\MiniMax\"",
        "Remove-Module -Name utils"
    ],
    "shortcuts": [
        [
            "MiniMax Code.exe",
            "MiniMax Code"
        ]
    ],
    "checkver": {
        "url": "https://agent.minimax.cn/docs/changelog.md",
        "regex": "MiniMax%20Code%20Setup%20(?<version>\\d+(?:\\.\\d+)+)\\.exe"
    },
    "autoupdate": {
        "url": "https://filecdn.minimax.chat/public/minimax-agent-prod/release/MiniMax%20Code%20Setup%20$version.exe#/dl.7z"
    }
}
