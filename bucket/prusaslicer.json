{
    "version": "2.9.6",
    "description": "G-code generator for 3D printers (RepRap, Makerbot, Ultimaker etc.)",
    "homepage": "https://www.prusa3d.com/prusaslicer/",
    "license": "AGPL-3.0-or-later",
    "architecture": {
        "64bit": {
            "url": "https://github.com/prusa3d/PrusaSlicer/releases/download/version_2.9.6/PrusaSlicer-2.9.6.zip",
            "hash": "5aaf22e42f95accecfa122d23a835911f289ecc2ff606db3e83d637ddcc0a209",
            "extract_dir": "PrusaSlicer-2.9.6"
        }
    },
    "pre_install": [
        "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name Koolar) scripts/utils.psm1)",
        "Initialize-ExternalRuntimeData -Source \"$persist_dir\\APPDATA\" -Target \"$env:APPDATA\\PrusaSlicer\"",
        "Initialize-ExternalRuntimeData -Source \"$persist_dir\\LOCALAPPDATA\" -Target \"$env:LOCALAPPDATA\\PrusaSlicer\"",
        "Remove-Module -Name utils"
    ],
    "post_install": [
        "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name Koolar) scripts/utils.psm1)",
        "Mount-ExternalRuntimeData -Source \"$persist_dir\\APPDATA\" -Target \"$env:APPDATA\\PrusaSlicer\"",
        "Mount-ExternalRuntimeData -Source \"$persist_dir\\LOCALAPPDATA\" -Target \"$env:LOCALAPPDATA\\PrusaSlicer\"",
        "Start-RunningApplication -StatePath \"$persist_dir\\.pre-uninstall-state.json\" -ExecutablePath \"$dir\\prusa-slicer.exe\"",
        "Remove-Module -Name utils"
    ],
    "pre_uninstall": [
        "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name Koolar) scripts/utils.psm1)",
        "Stop-RunningApplication -ProcessName @('prusa-slicer', 'prusa-slicer-console') -StatePath \"$persist_dir\\.pre-uninstall-state.json\"",
        "Dismount-ExternalRuntimeData -Target \"$env:APPDATA\\PrusaSlicer\"",
        "Dismount-ExternalRuntimeData -Target \"$env:LOCALAPPDATA\\PrusaSlicer\"",
        "Remove-Module -Name utils"
    ],
    "bin": "prusa-slicer-console.exe",
    "shortcuts": [
        [
            "prusa-slicer.exe",
            "PrusaSlicer"
        ]
    ],
    "checkver": {
        "github": "https://api.github.com/repos/prusa3d/PrusaSlicer/releases/latest",
        "jsonpath": "$.assets[*].browser_download_url",
        "regex": "PrusaSlicer-([\\d.]+)\\.zip"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/prusa3d/PrusaSlicer/releases/download/version_$version/PrusaSlicer-$version.zip",
                "extract_dir": "PrusaSlicer-$version"
            }
        }
    }
}
