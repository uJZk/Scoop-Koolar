{
    "version": "4.0.23",
    "description": "A desktop all-in-one assistant tool for AI coding agents.",
    "homepage": "https://ccswitch.io",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/farion1231/cc-switch/releases/download/v4.0.23/CC-Switch-v4.0.23-Windows-Portable.zip",
            "hash": "5ceca11e328479aa6050c2d5603b4238902ecb54f20ae955e6b21c71564df7f0"
        },
        "arm64": {
            "url": "https://github.com/farion1231/cc-switch/releases/download/v4.0.23/CC-Switch-v4.0.23-Windows-arm64-Portable.zip",
            "hash": "76f5b7a6407995423b24f0f021b8dafe1c4994d48461f934d0fb2f7150a62a9f"
        }
    },
    "pre_install": [
        "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name Koolar) scripts/utils.psm1)",
        "Initialize-ExternalRuntimeData -Source \"$persist_dir\\.cc-switch\" -Target \"$env:USERPROFILE\\.cc-switch\"",
        "Initialize-ExternalRuntimeData -Source \"$persist_dir\\APPDATA\" -Target \"$env:APPDATA\\com.ccswitch.desktop\"",
        "Initialize-ExternalRuntimeData -Source \"$persist_dir\\LOCALAPPDATA\" -Target \"$env:LOCALAPPDATA\\com.ccswitch.desktop\"",
        "Remove-Module -Name utils"
    ],
    "post_install": [
        "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name Koolar) scripts/utils.psm1)",
        "Mount-ExternalRuntimeData -Source \"$persist_dir\\.cc-switch\" -Target \"$env:USERPROFILE\\.cc-switch\"",
        "Mount-ExternalRuntimeData -Source \"$persist_dir\\APPDATA\" -Target \"$env:APPDATA\\com.ccswitch.desktop\"",
        "Mount-ExternalRuntimeData -Source \"$persist_dir\\LOCALAPPDATA\" -Target \"$env:LOCALAPPDATA\\com.ccswitch.desktop\"",
        "Start-RunningApplication -StatePath \"$persist_dir\\.pre-uninstall-state.json\" -ExecutablePath \"$dir\\cc-switch.exe\"",
        "Remove-Module -Name utils"
    ],
    "pre_uninstall": [
        "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name Koolar) scripts/utils.psm1)",
        "Stop-RunningApplication -ProcessName @('cc-switch') -StatePath \"$persist_dir\\.pre-uninstall-state.json\"",
        "Dismount-ExternalRuntimeData -Target \"$env:USERPROFILE\\.cc-switch\"",
        "Dismount-ExternalRuntimeData -Target \"$env:APPDATA\\com.ccswitch.desktop\"",
        "Dismount-ExternalRuntimeData -Target \"$env:LOCALAPPDATA\\com.ccswitch.desktop\"",
        "Remove-Module -Name utils"
    ],
    "shortcuts": [
        [
            "cc-switch.exe",
            "CC-Switch"
        ]
    ],
    "checkver": {
        "github": "https://github.com/farion1231/cc-switch"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/farion1231/cc-switch/releases/download/v$version/CC-Switch-v$version-Windows-Portable.zip"
            },
            "arm64": {
                "url": "https://github.com/farion1231/cc-switch/releases/download/v$version/CC-Switch-v$version-Windows-arm64-Portable.zip"
            }
        }
    }
}
