{
    "version": "3.8.2",
    "description": "Fast and Powerful Uninstaller for Complete Removal of Programs.",
    "homepage": "https://crystalidea.com/uninstall-tool",
    "license": {
        "identifier": "Shareware",
        "url": "https://crystalidea.com/eula"
    },
    "url": "https://github.com/crystalidea/uninstall-tool/releases/download/v3.8.2/uninstalltool_portable.zip",
    "hash": "bf12f8e56988a260dca9266905ec7aea260d5ed531eb51169facb3cdb6662bc8",
    "shortcuts": [
        [
            "UninstallToolPortable.exe",
            "Uninstall Tool"
        ]
    ],
    "pre_install": [
        "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name Koolar) scripts/utils.psm1)",
        "Initialize-ExternalRuntimeData -Source \"$env:APPDATA\\CrystalIdea Software\\Uninstall Tool\" -Target \"$persist_dir\\APPDATA\"",
        "Remove-Module -Name utils"
    ],
    "post_install": [
        "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name Koolar) scripts/utils.psm1)",
        "Mount-ExternalRuntimeData -Source \"$persist_dir\\APPDATA\" -Target \"$env:APPDATA\\CrystalIdea Software\\Uninstall Tool\"",
        "Remove-Module -Name utils"
    ],
    "pre_uninstall": [
        "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name Koolar) scripts/utils.psm1)",
        "Stop-RunningApplication -ProcessName @('UninstallToolPortable') -StatePath \"$persist_dir\\.pre-uninstall-state.json\"",
        "Dismount-ExternalRuntimeData -Target \"$env:APPDATA\\CrystalIdea Software\\Uninstall Tool\"",
        "Remove-Module -Name utils"
    ],
    "checkver": {
        "github": "https://github.com/crystalidea/uninstall-tool"
    },
    "autoupdate": {
        "url": "https://github.com/crystalidea/uninstall-tool/releases/download/v$version/uninstalltool_portable.zip"
    }
}
