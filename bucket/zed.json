{
    "version": "1.26.2",
    "description": "Zed is a high-performance, multiplayer code editor from the creators of Atom and Tree-sitter. It's also open source.",
    "homepage": "https://zed.dev/",
    "license": "AGPL-3.0, Apache-2.0, GPL-3.0",
    "notes": "Please manually disable Zed's auto-update feature in the settings to prevent the updater from installing the program in unintended locations.",
    "architecture": {
        "64bit": {
            "url": "https://github.com/zed-industries/zed/releases/download/v1.26.2/Zed-x86_64.exe",
            "hash": "22b20ef96ed7ce67cd4e869bc263b9ac345e3cffa86552330843c436da1bb17b"
        },
        "arm64": {
            "url": "https://github.com/zed-industries/zed/releases/download/v1.26.2/Zed-aarch64.exe",
            "hash": "e9f30fabcb7e0d118bec070640019c1811288440f05422ae39902f12e58845bf"
        }
    },
    "pre_install": [
        "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name Koolar) scripts/utils.psm1)",
        "Initialize-ExternalRuntimeData -Source \"$persist_dir\\LOCALAPPDATA\" -Target \"$env:LOCALAPPDATA\\Zed\"",
        "Initialize-ExternalRuntimeData -Source \"$persist_dir\\APPDATA\" -Target \"$env:APPDATA\\Zed\"",
        "Remove-Module -Name utils"
    ],
    "installer": {
        "script": [
            "Expand-InnoArchive -Path \"$dir\\$fname\" -ExtractDir '{app}'",
            "Expand-InnoArchive -Path \"$dir\\$fname\" -ExtractDir '{code_GetInstallDir}' -Removal"
        ]
    },
    "post_install": [
        "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name Koolar) scripts/utils.psm1)",
        "Mount-ExternalRuntimeData -Source \"$persist_dir\\LOCALAPPDATA\" -Target \"$env:LOCALAPPDATA\\Zed\"",
        "Mount-ExternalRuntimeData -Source \"$persist_dir\\APPDATA\" -Target \"$env:APPDATA\\Zed\"",
        "Remove-Module -Name utils"
    ],
    "pre_uninstall": [
        "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name Koolar) scripts/utils.psm1)",
        "Stop-RunningApplication -ProcessName @('Zed') -StatePath \"$persist_dir\\.pre-uninstall-state.json\"",
        "Dismount-ExternalRuntimeData -Target \"$env:LOCALAPPDATA\\Zed\"",
        "Dismount-ExternalRuntimeData -Target \"$env:APPDATA\\Zed\"",
        "Remove-Module -Name utils"
    ],
    "bin": "bin\\zed.exe",
    "shortcuts": [
        [
            "zed.exe",
            "Zed"
        ]
    ],
    "checkver": {
        "github": "https://github.com/zed-industries/zed"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/zed-industries/zed/releases/download/v$version/Zed-x86_64.exe"
            },
            "arm64": {
                "url": "https://github.com/zed-industries/zed/releases/download/v$version/Zed-aarch64.exe"
            }
        }
    }
}
